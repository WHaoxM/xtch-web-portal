# Linux VPS edge proxy (deploy target: cloud-vps).
# DNS A for these hostnames must point at this VPS (Cloudflare: prefer DNS-only
# until first cert works; then Full/strict if you turn the orange cloud on).
# Docs: docs/ops/cloud-vps.md
#
# Body limits and timeouts align with role-2 runtime constants
# (app/scripts/requestBodyLimits.ts):
#   JSON API 1 MiB · Stripe webhook 256 KiB · read 60s · body 30s
#
# Requires Caddy 2.10+ for `request_body` (stable package from bootstrap).
# Caddy is the only public entry — Node listens 127.0.0.1:3080 only.

{
	servers {
		timeouts {
			read_body 30s
			read_header 10s
		}
	}
}

(xtch_security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
	# Strict Content-Security-Policy is NOT enabled for V1.
	# Build and verify a source matrix first (see docs/ops/shared/caddy-csp-matrix.md).
}

(xtch_proxy_api) {
	reverse_proxy 127.0.0.1:3080 {
		transport http {
			response_header_timeout 60s
			read_timeout 60s
			write_timeout 60s
		}
	}
}

(xtch_proxy_default) {
	reverse_proxy 127.0.0.1:3080 {
		transport http {
			response_header_timeout 60s
			read_timeout 60s
			write_timeout 60s
		}
	}
}

# Apex (@) intentionally unused — only www (+ optional admin).
www.xuntingtravel.com, admin.xuntingtravel.com {
	import xtch_security_headers
	encode gzip

	# Stripe webhook — tighter body cap (256 KiB). Do not apply 1 MiB here.
	handle /api/stripe-webhook* {
		request_body {
			max_size 256KB
		}
		import xtch_proxy_api
	}

	# JSON APIs — 1 MiB body cap (matches serve-selfhost).
	handle /api/* {
		request_body {
			max_size 1MB
		}
		import xtch_proxy_api
	}

	# /s3 object GET/PUT (presigned uploads) — no 1 MiB cap; longer I/O budget.
	handle /s3/* {
		reverse_proxy 127.0.0.1:3080 {
			transport http {
				response_header_timeout 120s
				read_timeout 120s
				write_timeout 120s
			}
		}
	}

	# SPA / prerender / static — BrowserRouter deep links stay intact.
	handle {
		import xtch_proxy_default
	}
}
