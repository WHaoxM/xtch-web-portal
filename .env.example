# Docker Compose credentials (repo root). Copy to `.env` (gitignored) before:
#   docker compose up -d
#
# Do NOT put weak shared defaults here. Generate strong unique secrets per host.
# These values must match POSTGRES_URL / S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY
# in env/<target>/.env. See docs/ops/shared/compose-credentials.md.
#
# Placeholders only — replace every REPLACE_ME_* before first start.
# Changing this file (or compose) does NOT rotate passwords inside existing volumes.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_ME_POSTGRES_PASSWORD
POSTGRES_DB=xtch

MINIO_ROOT_USER=REPLACE_ME_MINIO_ROOT_USER
MINIO_ROOT_PASSWORD=REPLACE_ME_MINIO_ROOT_PASSWORD
