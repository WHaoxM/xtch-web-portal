# Local Vite daily env (target: local). Copy to env/local/.env and fill secrets.
# Layer overview: docs/ops/README.md
# Uses Dev Supabase. Not a public deploy target.

VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Local-only closed loop. Use memory storage and print email previews in the dev server log.
INQUIRY_STORAGE_MODE=memory
INQUIRY_EMAIL_MODE=console

# To test real Resend delivery locally:
# 1. Set RESEND_API_KEY to a real Resend API key.
# 2. Set INQUIRY_EMAIL_MODE=resend or remove INQUIRY_EMAIL_MODE.
# 3. Use a verified sender domain, or Resend's onboarding sender while testing allowed recipients.
INQUIRY_FROM_EMAIL=Syncing Travel <onboarding@resend.dev>
INQUIRY_TO_EMAIL=emonakhatun64@gmail.com
RESEND_API_KEY=

# Stripe Checkout for the mobile group-tour full-payment flow.
# Use a restricted Stripe secret key with Checkout Session creation permissions,
# or a standard test/live secret key. Never expose this value to the browser.
STRIPE_SECRET_KEY=
# Success lands back inside the China Trips mini-app "Booking confirmed" view.
# When unset, the code appends &order={orderNumber} automatically; a manual override
# can only template {CHECKOUT_SESSION_ID}, and the mini-app still resolves the order by session_id.
STRIPE_CHECKOUT_SUCCESS_URL=http://127.0.0.1:3000/china-trips?checkout=success&session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_URL=http://127.0.0.1:3000/china-trips?checkout=cancelled

# Stripe webhook endpoint secret. Get it from Stripe Dashboard, or run:
#   stripe listen --forward-to http://127.0.0.1:3000/api/stripe-webhook
# and copy the "whsec_..." value printed by the CLI.
STRIPE_WEBHOOK_SECRET=

# Dev-only: when STRIPE_SECRET_KEY is empty, create + confirm the order locally
# and redirect to the Mini-App Booking confirmed view (no Stripe Checkout).
# Also sends the booking confirmation email (same path as webhook / Admin resend).
# Ignored in production. NEVER set this in production or in any deployed environment.
DEV_CHECKOUT_BYPASS=1

# Postgres connection string for local development.
# Local Docker: postgresql://postgres:postgres@localhost:5432/xtch  (see ../../docker-compose.yml)
# For Supabase: Project Settings -> Database -> Connection string (Pooling)
POSTGRES_URL=

# Storage key prefix env segment: dev | prod (defaults from NODE_ENV if unset)
APP_ENV=dev

# MinIO / S3-compatible object storage (local Docker: see ../../docker-compose.yml)
# API-only secrets �?never expose S3_SECRET_ACCESS_KEY to the browser or Vercel frontend env.
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=xtch-public
S3_REGION=us-east-1
# Public base URL for objects (no trailing slash). Must be reachable by Vercel visitors in production.
# Object keys look like: {APP_ENV}/{image|video|pdf|file}/{yyyy}/{mm}/{uuid}-{filename}
S3_PUBLIC_BASE_URL=http://127.0.0.1:9000/xtch-public

# Supabase Auth for Google, Email magic link, and Apple sign-in.
# Enable Google and Apple providers in Supabase Auth settings.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_AUTH_REDIRECT_URL=http://127.0.0.1:3000/auth/callback

# Booking confirmation emails (Stripe webhook, Admin resend, and DEV_CHECKOUT_BYPASS).
# Defaults to INQUIRY_* values if unset. Keep INQUIRY_EMAIL_MODE=console for safe local defaults
# (status becomes "sent" but only a terminal preview is printed �?inbox stays empty; that is expected).
# To actually receive booking mail in your inbox:
# 1. Set RESEND_API_KEY to a real key.
# 2. Set BOOKING_EMAIL_MODE=resend (or remove console inheritance via INQUIRY_EMAIL_MODE).
# 3. Use a verified sender domain; Resend onboarding@resend.dev only delivers to allowlisted recipients.
# 4. Optional local redirect: BOOKING_EMAIL_OVERRIDE_TO=<your Resend account email>
#    so form lead emails that are not allowlisted still deliver while testing.
# 5. Set BOOKING_OPERATIONS_EMAIL explicitly; INQUIRY_TO_EMAIL is the fallback.
# BOOKING_FROM_EMAIL=Syncing Travel <onboarding@resend.dev>
# BOOKING_OPERATIONS_EMAIL=ops@example.com
# BOOKING_EMAIL_MODE=resend
# BOOKING_EMAIL_OVERRIDE_TO=you@example.com

# Dev-only auth bypass. When set to a test email, the frontend and backend
# skip Supabase sign-in and treat that email as signed in.
# Bypass email MUST also appear in ADMIN_OPS_EMAIL_ALLOWLIST or
# ADMIN_TECH_EMAIL_ALLOWLIST (or deprecated ADMIN_EMAIL_ALLOWLIST) or Admin APIs return 403.
# NEVER set this in production or in any deployed environment.
VITE_DEV_AUTH_BYPASS_EMAIL=
DEV_AUTH_BYPASS_EMAIL=
ADMIN_OPS_EMAIL_ALLOWLIST=
ADMIN_TECH_EMAIL_ALLOWLIST=
# DEPRECATED: treated as tech when both new lists above are empty.
# ADMIN_EMAIL_ALLOWLIST=

# Optional Admin quick password login (env credentials; not Supabase).
# Email must also be on ADMIN_OPS/TECH allowlist. Use a strong password in any shared/prod env.
# ADMIN_QUICK_LOGIN_EMAIL=
# ADMIN_QUICK_LOGIN_PASSWORD=
