# Tunnel testbed env (target: tunnel; vite --mode tunnel).
# Copy to env/tunnel/.env and fill secrets.
# Layer overview: docs/ops/README.md �?detail: docs/ops/tunnel.md
# Uses Dev Supabase. Not a production deploy target.
#
# WARNING: This stack is intentionally public-reachable with Admin + auth bypass.
# Do not treat it as production. Tear down the tunnel when finished.

# Isolated DB (not the daily `xtch` database)
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/xtch_tunnel

APP_ENV=dev

# MinIO bucket for tunnel-only media. S3_ENDPOINT / S3_PUBLIC_BASE_URL are rewritten
# by `npm run testbed:tunnel` to https://<trycloudflare>/s3 and .../s3/xtch-tunnel.
S3_ENDPOINT=http://127.0.0.1:3000/s3
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=xtch-tunnel
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=http://127.0.0.1:3000/s3/xtch-tunnel

# Leave empty �?tunnel testbed uses DEV_CHECKOUT_BYPASS (requires Vite dev, not NODE_ENV=production)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DEV_CHECKOUT_BYPASS=1

# Public URLs �?testbed script overwrites these with the live trycloudflare host when possible.
STRIPE_CHECKOUT_SUCCESS_URL=http://127.0.0.1:3000/china-trips?checkout=success&session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_URL=http://127.0.0.1:3000/china-trips?checkout=cancelled
VITE_AUTH_REDIRECT_URL=http://127.0.0.1:3000/auth/callback

# Auth / Admin �?prefer Dev Supabase + dual allowlists (D1).
# Recommended: leave bypass empty and sign in with a Dev-project user on the lists below.
# If you keep bypass for convenience, that email MUST be on ops or tech (PUBLIC tunnel = bare Admin).
# VITE_DEV_AUTH_BYPASS_EMAIL=
# DEV_AUTH_BYPASS_EMAIL=
ADMIN_OPS_EMAIL_ALLOWLIST=ops@example.com
ADMIN_TECH_EMAIL_ALLOWLIST=tech@example.com
# DEPRECATED (tech-only when both new lists empty): ADMIN_EMAIL_ALLOWLIST=

# Optional Admin quick password login (env; not Supabase). Email must be on allowlist above.
# ADMIN_QUICK_LOGIN_EMAIL=
# ADMIN_QUICK_LOGIN_PASSWORD=

# Dev Supabase project (tunnel + local share this; not Prod)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Real inbox delivery via Resend (override to your Resend account email while on onboarding domain)
INQUIRY_STORAGE_MODE=memory
INQUIRY_EMAIL_MODE=resend
BOOKING_EMAIL_MODE=resend
INQUIRY_FROM_EMAIL=Syncing Travel <onboarding@resend.dev>
BOOKING_FROM_EMAIL=Syncing Travel <onboarding@resend.dev>
# Preferred booking Reply-To + internal paid-order recipient (falls back to INQUIRY_TO_EMAIL).
BOOKING_OPERATIONS_EMAIL=you@example.com
BOOKING_EMAIL_OVERRIDE_TO=you@example.com
INQUIRY_TO_EMAIL=you@example.com
RESEND_API_KEY=

# Optional Turnstile test keys (same as .env.local.example)
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
