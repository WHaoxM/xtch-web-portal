# Win11 home public deploy (target: win11-home; production A � home broadband).
# Copy to env/win11-home/.env and fill secrets.
# Layer overview: docs/ops/README.md � detail: docs/ops/win11-home.md
# Uses Prod Supabase + dual Admin allowlists.
#
# Legacy: app/.env.win11-home.local or app/.env.selfhost.local still work for one
# migration round (loaders warn). Prefer env/win11-home/.env so Vite
# --mode win11-home picks up VITE_* at build time.
#
# PUBLIC deploy target: never set DEV_CHECKOUT_BYPASS / DEV_AUTH_BYPASS_EMAIL /
# VITE_DEV_AUTH_BYPASS_EMAIL. deploy:serve refuses to start if they are set.
#
# Compose credentials (repo-root .env) must match POSTGRES_URL / S3_* below.
# See docs/ops/shared/compose-credentials.md � no docker default passwords.

# Isolated production database (not daily xtch, not xtch_tunnel)
POSTGRES_URL=postgresql://postgres:REPLACE_ME_POSTGRES_PASSWORD@127.0.0.1:5432/xtch_prod

# Storage key prefix: prod on the public host
APP_ENV=prod

# Public site origin priority (no internet probe for public IP):
#   PUBLIC_DOMAIN > PUBLIC_IP > LAN auto-detect (when APP_ENV=prod)
# With Caddy as the only public entry, prefer SELFHOST_HOST=127.0.0.1.
# Use 0.0.0.0 only when you intentionally need LAN direct access to :3080.
PUBLIC_DOMAIN=
# PUBLIC_IP=203.0.113.10
SELFHOST_HOST=127.0.0.1
SELFHOST_PORT=3080
# (default 3080 � keep off Vite/dev :3000 so both can run on one machine)

# Behind Caddy only � enables X-Forwarded-For for checkout rate limits.
# If you temporarily hit Node on :3080 without Caddy, set TRUST_PROXY=0.
TRUST_PROXY=1

# Sign against local MinIO (Host must match what the /s3 proxy forwards).
S3_ENDPOINT=http://127.0.0.1:9000
# Optional overrides. Prefer leave empty so /s3 follows the browser Host.
# S3_BROWSER_ENDPOINT=https://www.example.com/s3
S3_ACCESS_KEY_ID=REPLACE_ME_MINIO_ROOT_USER
S3_SECRET_ACCESS_KEY=REPLACE_ME_MINIO_ROOT_PASSWORD
S3_BUCKET=xtch-prod
S3_REGION=us-east-1
# S3_PUBLIC_BASE_URL=https://www.example.com/s3/xtch-prod

# Traveler checkout provider (default payoneer). Stripe code remains as fallback.
PAYMENT_PROVIDER=payoneer
VITE_PAYMENT_PROVIDER=payoneer
PAYONEER_STORE_CODE=
PAYONEER_TOKEN=
# PAYONEER_WEBHOOK_SECRET=
# PAYONEER_NOTIFICATION_URL=https://www.example.com/api/payoneer-webhook
# PAYONEER_CHECKOUT_SUCCESS_URL=https://www.example.com/china-trips?checkout=success&session_id={CHECKOUT_SESSION_ID}
# PAYONEER_CHECKOUT_CANCEL_URL=https://www.example.com/china-trips?checkout=cancelled

# Stripe — leave empty until you intentionally enable PAYMENT_PROVIDER=stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Do NOT set DEV_CHECKOUT_BYPASS here.

# Absolute checkout URLs when enabling Stripe (use your preferred public origin).
# STRIPE_CHECKOUT_SUCCESS_URL=https://www.example.com/china-trips?checkout=success&session_id={CHECKOUT_SESSION_ID}
# STRIPE_CHECKOUT_CANCEL_URL=https://www.example.com/china-trips?checkout=cancelled

# Multi-entry Auth: leave VITE_AUTH_REDIRECT_URL unset so the client uses
# window.location.origin. Register every origin you use in Supabase + Google
# (domain, public IP, LAN IP). Rebuild after changing any VITE_*.
# VITE_AUTH_REDIRECT_URL=https://www.example.com/auth/callback

# Prod Supabase Auth + dual Admin allowlists (no bypass).
# deploy:serve refuses to start if both new lists and legacy are empty, or only you@example.com.
# Put real operator emails here (never commit secrets or real addresses to git).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
ADMIN_OPS_EMAIL_ALLOWLIST=
ADMIN_TECH_EMAIL_ALLOWLIST=
# DEPRECATED (tech-only when both new lists empty): ADMIN_EMAIL_ALLOWLIST=

# Optional Admin quick password login (env; not Supabase). Email must be on allowlist above.
# ADMIN_QUICK_LOGIN_EMAIL=
# ADMIN_QUICK_LOGIN_PASSWORD=

# Email � set Resend when you want real delivery
INQUIRY_STORAGE_MODE=postgres
INQUIRY_EMAIL_MODE=resend
BOOKING_EMAIL_MODE=resend
INQUIRY_FROM_EMAIL=Syncing Travel <onboarding@resend.dev>
BOOKING_FROM_EMAIL=Syncing Travel <onboarding@resend.dev>
# Paid-order internal copy recipient and traveler Reply-To. Required for booking delivery;
# if empty, INQUIRY_TO_EMAIL is used as the compatibility fallback.
BOOKING_OPERATIONS_EMAIL=
INQUIRY_TO_EMAIL=
RESEND_API_KEY=

# Optional Turnstile (production keys)
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
