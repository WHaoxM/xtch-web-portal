# Linux VPS public deploy (target: cloud-vps; production B — cloud host).
# Copy to env/cloud-vps/.env and fill secrets.
# Layer overview: docs/ops/README.md — detail: docs/ops/cloud-vps.md
# Uses Prod Supabase + dual Admin allowlists.
#
# Start with empty Postgres (xtch_prod) + empty MinIO bucket (xtch-prod).
# Migrating data from Win11 is a separate task — do not reuse Win11 secrets blindly.
#
# PUBLIC deploy target: never set DEV_CHECKOUT_BYPASS / DEV_AUTH_BYPASS_EMAIL /
# VITE_DEV_AUTH_BYPASS_EMAIL. deploy:serve refuses to start if they are set.

# Isolated production database on this VPS (not daily xtch, not xtch_tunnel)
POSTGRES_URL=postgresql://postgres:CHANGE_ME_PG_PASSWORD@127.0.0.1:5432/xtch_prod

# Storage key prefix: prod on the public host
APP_ENV=prod

# Public site origin priority: PUBLIC_DOMAIN > PUBLIC_IP > LAN (prod only).
# deploy:serve default SELFHOST_HOST=0.0.0.0, SELFHOST_PORT=3080 (not Vite :3000).
# PUBLIC_DOMAIN=your.domain.com
# PUBLIC_IP=203.0.113.10
# SELFHOST_PORT=3080

# Sign against local MinIO (Host must match what the /s3 proxy forwards).
S3_ENDPOINT=http://127.0.0.1:9000
# Optional; leave empty so /s3 follows browser Host. YOUR_DOMAIN placeholders are ignored.
# S3_BROWSER_ENDPOINT=https://your.domain.com/s3
S3_ACCESS_KEY_ID=CHANGE_ME_MINIO_USER
S3_SECRET_ACCESS_KEY=CHANGE_ME_MINIO_PASSWORD
S3_BUCKET=xtch-prod
S3_REGION=us-east-1
# S3_PUBLIC_BASE_URL=https://your.domain.com/s3/xtch-prod

# Stripe — leave empty until you intentionally enable live/test checkout + webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Do NOT set DEV_CHECKOUT_BYPASS here.

# STRIPE_CHECKOUT_SUCCESS_URL=https://your.domain.com/#/china-trips?checkout=success&session_id={CHECKOUT_SESSION_ID}
# STRIPE_CHECKOUT_CANCEL_URL=https://your.domain.com/#/china-trips?checkout=cancelled

# Multi-entry Auth: leave unset → window.location.origin. Whitelist each origin in Supabase/Google.
# VITE_AUTH_REDIRECT_URL=https://your.domain.com/#/china-trips?auth=callback

# Prod Supabase Auth + dual Admin allowlists (no bypass).
# deploy:serve refuses to start if both new lists and legacy are empty, or only you@example.com.
# Put real operator emails here (never commit secrets or real addresses to git).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
ADMIN_OPS_EMAIL_ALLOWLIST=
ADMIN_TECH_EMAIL_ALLOWLIST=
# DEPRECATED (tech-only when both new lists empty): ADMIN_EMAIL_ALLOWLIST=

# Email — set Resend when you want real delivery
INQUIRY_STORAGE_MODE=postgres
INQUIRY_EMAIL_MODE=resend
BOOKING_EMAIL_MODE=resend
INQUIRY_FROM_EMAIL=Syncing Travel <onboarding@resend.dev>
BOOKING_FROM_EMAIL=Syncing Travel <onboarding@resend.dev>
INQUIRY_TO_EMAIL=you@example.com
RESEND_API_KEY=

# Optional Turnstile (production keys)
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
